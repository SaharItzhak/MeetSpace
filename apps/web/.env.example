# --- Database ---------------------------------------------------------------
# Postgres connection string. Works with Supabase or Neon free tiers (see README).
DATABASE_URL="postgresql://user:password@localhost:5432/meetspace"

# --- Auth.js (NextAuth) -------------------------------------------------------
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-with-a-long-random-string"
# NEXTAUTH_SECRET is an alias some tooling/older docs expect; keep both set to the same value.
NEXTAUTH_SECRET="replace-with-a-long-random-string"
# Only needed if NEXTAUTH_URL can't be inferred (e.g. some non-Vercel hosts).
# NEXTAUTH_URL="http://localhost:3000"

# Google OAuth client (console.cloud.google.com -> APIs & Services -> Credentials).
# Needs the "Google Calendar API" enabled on the project and these scopes available:
#   openid email profile  (base login)
#   https://www.googleapis.com/auth/calendar.events
#   https://www.googleapis.com/auth/calendar.freebusy
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Email (Resend) -----------------------------------------------------------
RESEND_API_KEY=""
EMAIL_FROM="MeetSpace <onboarding@resend.dev>"

# --- Reminders cron ------------------------------------------------------------
# Shared secret the GitHub Actions "Reminders Cron" workflow sends as a Bearer token
# when it calls POST /api/cron/reminders. Set this in Vercel env vars AND as a
# repo secret (CRON_SECRET) in GitHub Actions, along with an APP_URL repo secret
# pointing at your deployed app.
CRON_SECRET="replace-with-a-long-random-string"

# --- Dev/test escape hatches -----------------------------------------------
# Set to "1" to use in-memory mock Calendar/Email adapters instead of real
# Google/Resend calls (used automatically in CI and recommended for local dev
# until you have real OAuth credentials configured).
MOCK_CALENDAR="1"
MOCK_EMAIL="1"
